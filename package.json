{
  "name": "foliomind",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "pnpm --filter web exec playwright test",
    "db:generate": "pnpm --filter @foliomind/db exec drizzle-kit generate",
    "db:migrate": "pnpm --filter @foliomind/db exec drizzle-kit migrate",
    "db:studio": "pnpm --filter @foliomind/db exec drizzle-kit studio",
    "stack:up": "docker compose -f infra/compose.yaml up -d",
    "stack:down": "docker compose -f infra/compose.yaml down",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  }
}
