# FolioMind web app environment (blueprint Section 13).
# Copy to apps/web/.env.local for local development. Never commit real values.
# Local infrastructure defaults below match infra/compose.yaml (`pnpm stack:up`).
# Third-party keys may stay empty in development; they are required once
# APP_ENV is "staging" or "production". See docs/setup/third-party-services.md.

# --- Runtime -------------------------------------------------------------
# development | test | staging | production (Vercel sets VERCEL_ENV as a fallback)
APP_ENV=development
LOG_LEVEL=info

# --- Database (Neon in staging/production; Compose Postgres locally) -------
# Pooled connection string for short web requests, as the least-privilege
# runtime role (created by `pnpm db:roles`; see docs/setup/database.md).
DATABASE_URL=postgres://foliomind_app:foliomind_app@localhost:5433/foliomind

# --- Upstash Redis (rate limits and rebuildable caches, Section 23) ---------
# Local: the Compose REST proxy. The token must match infra/.env UPSTASH_LOCAL_TOKEN.
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=foliomind-local-dev-token
# HMAC key for guest IP identifiers; use a long random value outside development.
RATE_LIMIT_IP_SECRET=local-development-rate-limit-secret

# --- Inngest (the web app only sends events) ------------------------------
# 1 = local Dev Server at http://localhost:8288. Leave unset in staging/production.
INNGEST_DEV=1
INNGEST_BASE_URL=
INNGEST_EVENT_KEY=

# --- Auth0 (Regular Web Application; Google and GitHub connections) --------
# Domain without https://, e.g. foliomind-dev.us.auth0.com
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 64 hex characters: openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
# Machine-to-Machine application for the Management API (account linking, deletion)
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=

# --- UploadThing (files, Section 25) --------------------------------------
UPLOADTHING_TOKEN=

# --- Jina AI (embeddings, reranker, Reader) -------------------------------
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v5-text-small
JINA_EMBEDDING_DIMENSION=1024
JINA_RERANKER_MODEL=jina-reranker-v3.5

# --- Google Gemini --------------------------------------------------------
# Exact model IDs (aliases such as gemini-flash-latest move to new, sometimes overloaded models).
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_GENERATION_MODEL=gemini-3.6-flash

# --- Stripe (test mode only until Section 10 go-live) ---------------------
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=
# Created in Phase 10
STRIPE_PRO_MONTHLY_PRICE_ID=
