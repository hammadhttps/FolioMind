# Worker B (foliomind-generation) environment (blueprint Section 13).
# Copy to apps/worker-generation/.env for local development. Never commit real values.
# Least privilege: no Auth0, Stripe or PushEngage secrets.

# --- Runtime -------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=info

# --- Database: direct connection for workers ------------------------------
DIRECT_DATABASE_URL=postgres://foliomind:foliomind@localhost:5433/foliomind

# --- Upstash Redis ---------------------------------------------------------
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=foliomind-local-dev-token

# --- Inngest (functions run here through Connect) -------------------------
INNGEST_DEV=1
INNGEST_BASE_URL=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
WORKER_INSTANCE_ID=

# --- UploadThing (generated exports) --------------------------------------
UPLOADTHING_TOKEN=

# --- Browserless (PDF export, Section 26) ---------------------------------
BROWSERLESS_WS_ENDPOINT=ws://localhost:3001
BROWSERLESS_TOKEN=foliomind-local-dev-token

# --- Jina AI (per-section evidence retrieval) -----------------------------
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v5-text-small
JINA_EMBEDDING_DIMENSION=1024
JINA_RERANKER_MODEL=jina-reranker-v3.5

# --- Google Gemini (outlines and drafts) ----------------------------------
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_GENERATION_MODEL=gemini-3.6-flash

# --- Concurrency (one heavy run at a time, Section 9) ---------------------
GENERATION_CONCURRENCY=1
