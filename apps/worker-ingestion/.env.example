# Worker A (foliomind-ingestion) environment (blueprint Section 13).
# Copy to apps/worker-ingestion/.env for local development. Never commit real values.
# Least privilege: no Auth0, Gemini or web-only secrets.

# --- Runtime -------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=info

# --- Database: direct connection for workers ------------------------------
DIRECT_DATABASE_URL=postgres://foliomind:foliomind@localhost:5433/foliomind

# --- Upstash Redis ---------------------------------------------------------
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=foliomind-local-dev-token

# --- Inngest (functions run here through Connect) -------------------------
# 1 = local Dev Server. In staging/production set the event and signing keys instead.
INNGEST_DEV=1
INNGEST_BASE_URL=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Optional stable Connect instance ID (defaults to the hostname)
WORKER_INSTANCE_ID=

# --- UploadThing (web-import snapshots, file cleanup) ---------------------
UPLOADTHING_TOKEN=

# --- Browserless (web-import snapshots, Section 26) -----------------------
# Local: the Compose container. The token must match infra/.env BROWSERLESS_LOCAL_TOKEN.
BROWSERLESS_WS_ENDPOINT=ws://localhost:3001
BROWSERLESS_TOKEN=foliomind-local-dev-token

# --- Jina AI (embeddings, Reader) -----------------------------------------
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v5-text-small
JINA_EMBEDDING_DIMENSION=1024
JINA_RERANKER_MODEL=jina-reranker-v3.5

# --- Stripe (billing sync and reconciliation; test mode locally) ----------
STRIPE_SECRET_KEY=

# --- PushEngage (optional notification delivery; never required) --------
PUSHENGAGE_API_KEY=

# --- Concurrency (Section 9 starting limits) ------------------------------
INGESTION_CONCURRENCY=1
IMPORT_CONCURRENCY=2
CONTROL_CONCURRENCY=2
