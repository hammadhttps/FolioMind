# Local Docker Compose settings (infra/compose.yaml). Copy to infra/.env to override.
# These tokens protect local-only services; they are not production secrets.
# Keep them in sync with UPSTASH_REDIS_REST_TOKEN and BROWSERLESS_TOKEN in the app env files.
# Host port for the Compose Postgres (5432 is often taken by a native install).
# Keep it in sync with DATABASE_URL / DIRECT_DATABASE_URL in the app env files.
POSTGRES_HOST_PORT=5433
UPSTASH_LOCAL_TOKEN=foliomind-local-dev-token
BROWSERLESS_LOCAL_TOKEN=foliomind-local-dev-token
