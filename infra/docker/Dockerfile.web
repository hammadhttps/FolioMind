# syntax=docker/dockerfile:1.7
# FolioMind web app (Next.js standalone). Build from the repository root:
#   docker build -f infra/docker/Dockerfile.web -t foliomind-web .
# Production runs on Vercel; this image is for local/portable use (Section 13).

ARG NODE_IMAGE=node:24.11.0-bookworm-slim
ARG TURBO_VERSION=2.11.10

FROM ${NODE_IMAGE} AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV NEXT_TELEMETRY_DISABLED=1
RUN corepack enable
WORKDIR /repo

# Keep only the web app and the workspace packages it depends on.
FROM base AS prune
ARG TURBO_VERSION
COPY . .
RUN pnpm dlx turbo@${TURBO_VERSION} prune web --docker

FROM base AS build
COPY --from=prune /repo/out/json/ ./
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile
COPY --from=prune /repo/out/full/ ./
# Environment is validated at runtime, never baked into the image.
ENV SKIP_ENV_VALIDATION=1
RUN pnpm turbo run build --filter=web

FROM ${NODE_IMAGE} AS runtime
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
WORKDIR /app
COPY --from=build --chown=node:node /repo/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=node:node /repo/apps/web/public ./apps/web/public
USER node
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
